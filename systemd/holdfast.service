[Unit]
Description=Holdfast daemon
Documentation=file:///usr/share/doc/holdfast/PROTOCOL.md
Documentation=file:///usr/share/doc/holdfast/JAIL.md
After=network.target

[Service]
Type=simple
ExecStart=holdfastd
Restart=on-failure
RestartSec=2
Environment=HOLDFAST_SOCK=/tmp/holdfast.sock
Environment=PATH=/usr/local/bin:/usr/bin

[Install]
WantedBy=multi-user.target
